{
  "name": "@tasks/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "init-template": "tsx scripts/init-template.ts",
    "build": "turbo build",
    "build:prod": "turbo build:prod",
    "dev": "turbo dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:ui": "vitest --ui",
    "i18n": "turbo i18n",
    "fullcheck": "turbo check:fix typecheck test",
    "web": "pnpm --dir apps/web",
    "core": "pnpm --dir packages/core",
    "db": "pnpm --dir packages/db",
    "db:up": "pnpm --dir packages/db db:up",
    "db:up:prod": "pnpm --dir packages/db db:up:prod",
    "db:create": "pnpm --dir packages/db db:create"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/github": "^12.0.9",
    "@tasks/typescript-config": "workspace:*",
    "@vitest/ui": "^4.1.11",
    "lefthook": "^2.1.10",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.12",
    "turbo": "^2.10.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.23.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18"
    }
  }
}
